          "set": {
            "BOX_SENS": 0,
            "RESET": 0
          },
          "expect": {
            "GATE": 0
          }
        },
        {
          "t": 20,
          "set": {
            "BOX_SENS": 1
          },
          "expect": {
            "GATE": 0
          }
        },
        {
          "t": 40,
          "set": {
            "BOX_SENS": 0
          },
          "expect": {
            "GATE": 0
          }
        },
        {
          "t": 60,
          "set": {
            "BOX_SENS": 1
          },
          "expect": {
            "GATE": 0
          }
        },
        {
          "t": 80,
          "set": {
            "BOX_SENS": 0
          },
          "expect": {
            "GATE": 0
          }
        },
        {
          "t": 100,
          "set": {
            "BOX_SENS": 1
          },
          "expect": {
            "GATE": 0
          }
        },
        {
          "t": 120,
          "set": {
            "BOX_SENS": 0
          },
          "expect": {
            "GATE": 0
          }
        },
        {
          "t": 140,
          "set": {
            "BOX_SENS": 1
          },
          "expect": {
            "GATE": 0
          }
        },
        {
