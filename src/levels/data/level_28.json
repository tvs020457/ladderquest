{
  "id": 28,
  "mode": "write",
  "unit": 7,
  "unitTitle": "Counting",
  "title": "Write: 5-Box Batch Counter (CTU)",
  "story": "Batch boxing: Each pulse of BOX_SENS counts one box. After 5 boxes, close the GATE. A held sensor must count only ONCE. Pressing RESET clears the count.",
  "concept": "Edge-triggered counting: CTU increments only on false-to-true transitions.",
  "inputs": [
    {
      "tag": "BOX_SENS",
      "type": "sensor",
      "description": "Box sensor"
    },
    {
      "tag": "RESET",
      "type": "pushbutton NO",
      "description": "Reset"
    }
  ],
  "outputs": [
    {
      "tag": "GATE",
      "type": "valve",
      "description": "Batch gate"
    }
  ],
  "allowedElements": [
    "XIC",
    "OTE",
    "CTU",
    "RES"
  ],
  "scanMs": 10,
  "parElements": 4,
  "learn": [
    {
      "title": "Pulse Counting",
      "text": "Held inputs count once. RES instruction clears ACC."
    }
  ],
  "initialParts": [],
  "initialWires": [],
  "tests": [
    {
      "name": "5 pulses close gate, reset clears",
      "steps": [
        {
